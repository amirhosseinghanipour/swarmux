{
  "$id": "https://raw.githubusercontent.com/amirhosseinghanipour/swarmux/main/schema/theme.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A theme as `swarmux theme export` writes it: colours by role.",
  "properties": {
    "schema_version": {
      "default": 1,
      "description": "The version of this file's format. Additive changes keep it; a breaking change raises it.",
      "minimum": 1,
      "type": "integer"
    },
    "theme": {
      "description": "The theme in use.",
      "type": "string"
    },
    "themes": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "base": {
            "description": "The theme this one starts from.",
            "type": "string"
          },
          "bg": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "border": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "border_focus": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "builder": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "chart": {
            "items": {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "dim": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "error": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "gauge": {
            "items": {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "guard": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "haiku": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "label": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "lead": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "muted": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "ok": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "on_accent": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "panel_bg": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "reviewer": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "text": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "title": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "warn": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "object"
    }
  },
  "title": "swarmux theme",
  "type": "object"
}
